<Window
    x:Class="Echse.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Echse Launcher">
    <Grid x:Name="Root" Background="{ThemeResource LauncherSurfaceTint}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="{ThemeResource LauncherLibrarySidebarBrush}">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,0" VerticalAlignment="Center">
                <Viewbox Width="25" Height="25" AutomationProperties.Name="Eidechse">
                    <Canvas Width="64" Height="64">
                        <Path Fill="{ThemeResource LauncherAccentBrush}"
                              Data="M 28,37 C 13,38 8,46 17,51 C 26,55 25,44 19,46 C 24,39 35,46 28,55 C 18,67 1,53 8,43 C 12,37 18,34 24,33 C 23,28 25,23 29,20 L 22,14 L 13,16 L 10,12 L 22,9 L 34,16 L 40,13 C 43,6 49,3 55,6 L 62,14 L 55,21 L 47,23 L 43,30 L 51,36 L 60,34 L 63,39 L 50,43 L 38,35 L 34,40 L 38,48 L 34,56 L 29,55 L 32,47 Z"/>
                        <Ellipse Canvas.Left="51" Canvas.Top="10" Width="4" Height="4" Fill="#1C1C1C"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="ECHSE" FontWeight="SemiBold" CharacterSpacing="180" FontSize="12"/>
                <TextBlock Text="LAUNCHER" Opacity="0.45" CharacterSpacing="120" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1"
                        Background="Transparent"
                        PaneDisplayMode="Top" IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False" IsSettingsVisible="True"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#B321000C"/>
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#DC819B"/>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource SystemColorWindowColor}"/>
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource SystemColorWindowColor}"/>
                            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="{ThemeResource SystemColorWindowColor}"/>
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}"/>
                            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Entdecken" Tag="store" Icon="Shop"/>
                <NavigationViewItem Content="Bibliothek" Tag="library" Icon="Library"/>
                <NavigationViewItem Content="Downloads" Tag="downloads" Icon="Download"/>
                <NavigationViewItem Content="Mein Profil" Tag="profile" Icon="Contact"/>
            </NavigationView.MenuItems>
            <Grid Padding="20,18,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Margin="0,0,0,12"/>
                <Grid x:Name="PageLayout" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="LibrarySidebar" Margin="-20,-18,16,-20" Padding="10,10,6,12"
                          Background="{ThemeResource LauncherLibrarySidebarBrush}" Visibility="Collapsed" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Padding="6,4"
                                Click="LibraryHome_Click" AutomationProperties.Name="Bibliotheksübersicht">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE80F;" FontSize="16"/>
                                <TextBlock Text="Bibliothek" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="LibrarySearch" Grid.Row="1" PlaceholderText="Spiele suchen"
                                 AutomationProperties.Name="Bibliothek durchsuchen" FontSize="12"
                                 TextChanged="LibrarySearch_TextChanged"/>
                        <ListView x:Name="LibraryGameList" Grid.Row="2" IsItemClickEnabled="True"
                                  SelectionMode="Single" ItemClick="LibraryGameList_ItemClick"
                                  ContainerContentChanging="LibraryGameList_ContainerContentChanging"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="28"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="18" Height="18">
                                            <FontIcon Glyph="&#xE7FC;" FontSize="12" Opacity="0.6"/>
                                            <Image Source="{Binding Game.CoverUrl}" Stretch="UniformToFill"
                                                   ImageFailed="ImageFailed"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Game.Title}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Grid x:Name="CatalogSidebar" Width="220" Margin="0,0,20,0" Visibility="Collapsed"
                          Background="{ThemeResource LauncherLibrarySidebarBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SPIELE ENTDECKEN" Foreground="{ThemeResource LauncherAccentBrush}" FontSize="11"
                                   CharacterSpacing="120" Margin="10,8,0,16"/>
                        <ListView x:Name="CatalogGameList" Grid.Row="1" SelectionMode="None"
                                  IsItemClickEnabled="True" ItemClick="CatalogGameList_ItemClick"
                                  DisplayMemberPath="Title">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="30"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                    <ScrollViewer x:Name="PageScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                        <StackPanel x:Name="PageHost" Spacing="24" MaxWidth="1460" HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
        <Grid x:Name="ImageLightbox" Grid.Row="1" Background="{ThemeResource LauncherDialogBrush}" Visibility="Collapsed"
              Padding="20,12,20,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ImageViewerTitle" FontSize="18" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button x:Name="CloseImageButton" Grid.Column="1" Content="Schließen · Esc"
                        Click="CloseImage_Click"/>
            </Grid>
            <ScrollViewer x:Name="ImageZoom" Grid.Row="1" ZoomMode="Enabled"
                          MinZoomFactor="1" MaxZoomFactor="4"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Grid x:Name="ImageStage" Margin="12">
                    <ProgressRing x:Name="ImageLoading" IsActive="False" Width="40" Height="40"/>
                    <Image x:Name="FullImage" Stretch="Uniform"
                           ImageOpened="FullImage_Opened" ImageFailed="FullImage_Failed"/>
                    <TextBlock x:Name="ImageViewerError" Visibility="Collapsed" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                               Text="Das Bild konnte nicht geladen werden. Prüfe deine Internetverbindung oder wähle ein anderes Bild."/>
                </Grid>
            </ScrollViewer>
            <Button x:Name="PreviousImage" Grid.Row="1" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Width="52" Height="70" Margin="4"
                    Background="{ThemeResource LauncherPanelBrush}" AutomationProperties.Name="Vorheriges Bild"
                    ToolTipService.ToolTip="Vorheriges Bild · Pfeil links" Click="PreviousImage_Click">
                <FontIcon Glyph="&#xE76B;" FontSize="26"/>
            </Button>
            <Button x:Name="NextImage" Grid.Row="1" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Width="52" Height="70" Margin="4"
                    Background="{ThemeResource LauncherPanelBrush}" AutomationProperties.Name="Nächstes Bild"
                    ToolTipService.ToolTip="Nächstes Bild · Pfeil rechts" Click="NextImage_Click">
                <FontIcon Glyph="&#xE76C;" FontSize="26"/>
            </Button>
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="← / →  Bild wechseln" Opacity="0.6" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="−" AutomationProperties.Name="Bild verkleinern" Click="ZoomOut_Click"/>
                    <Button Content="Einpassen" Click="FitImage_Click"/>
                    <Button Content="+" AutomationProperties.Name="Bild vergrößern" Click="ZoomIn_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
