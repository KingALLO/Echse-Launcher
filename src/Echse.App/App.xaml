<Application
    x:Class="Echse.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="LauncherCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="ListViewItemCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="GridViewItemCornerRadius">10</CornerRadius>
            <Style x:Key="ArtworkGridItemStyle" TargetType="GridViewItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="IsTabStop" Value="False"/>
            </Style>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LauncherSurfaceTint" Color="#E672232D"/>
                    <Color x:Key="SystemAccentColor">#B54548</Color>
                    <Color x:Key="SystemAccentColorLight1">#E5484D</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF9592</Color>
                    <Color x:Key="SystemAccentColorLight3">#FFD1D9</Color>
                    <SolidColorBrush x:Key="LauncherAccentBrush" Color="#FF9592"/>
                    <SolidColorBrush x:Key="LauncherActionBrush" Color="#B54548"/>
                    <SolidColorBrush x:Key="LauncherActionHoverBrush" Color="#C44C50"/>
                    <SolidColorBrush x:Key="LauncherActionPressedBrush" Color="#8C333A"/>
                    <SolidColorBrush x:Key="LauncherLibrarySidebarBrush" Color="#F2201314"/>
                    <SolidColorBrush x:Key="LauncherLibraryOverlayBrush" Color="#EB201314"/>
                    <SolidColorBrush x:Key="LauncherPanelBrush" Color="#E6611623"/>
                    <SolidColorBrush x:Key="LauncherBorderBrush" Color="#8C333A"/>
                    <SolidColorBrush x:Key="LauncherMutedBrush" Color="#FFD1D9"/>
                    <SolidColorBrush x:Key="LauncherDialogBrush" Color="#FF3B1219"/>
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B3500F1C"/>
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#E6611623"/>
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#B33B1219"/>
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#8C333A"/>
                    <SolidColorBrush x:Key="TextControlBackground" Color="#B33B1219"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#E6500F1C"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF3B1219"/>
                    <SolidColorBrush x:Key="ContentDialogBackground" Color="#FF3B1219"/>
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF3B1219"/>
                    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF611623"/>
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FF3B1219"/>
                    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FF500F1C"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF3B1219"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FF3B1219"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FF611623"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FF72232D"/>
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#B54548"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#C44C50"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#8C333A"/>
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="White"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White"/>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#B54548"/>
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#C44C50"/>
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#8C333A"/>
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF9592"/>
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFD1D9"/>
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFD1D9"/>
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="White"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="LauncherSurfaceTint" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="LauncherAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="LauncherActionBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="LauncherActionHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="LauncherActionPressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="LauncherLibrarySidebarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="LauncherLibraryOverlayBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="LauncherPanelBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="LauncherBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="LauncherMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="LauncherDialogBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
