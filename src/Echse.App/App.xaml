<Application
    x:Class="Echse.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LauncherSurfaceTint" Color="#CC4D0B20"/>
                    <Color x:Key="SystemAccentColor">#4D0B20</Color>
                    <Color x:Key="SystemAccentColorLight1">#B84969</Color>
                    <Color x:Key="SystemAccentColorLight2">#DC819B</Color>
                    <Color x:Key="SystemAccentColorLight3">#F1B5C6</Color>
                    <SolidColorBrush x:Key="LauncherAccentBrush" Color="#DC819B"/>
                    <SolidColorBrush x:Key="LauncherActionBrush" Color="#4D0B20"/>
                    <SolidColorBrush x:Key="LauncherActionHoverBrush" Color="#64182F"/>
                    <SolidColorBrush x:Key="LauncherActionPressedBrush" Color="#3B0818"/>
                    <SolidColorBrush x:Key="LauncherLibrarySidebarBrush" Color="#DB21000C"/>
                    <SolidColorBrush x:Key="LauncherLibraryOverlayBrush" Color="#D9211019"/>
                    <SolidColorBrush x:Key="LauncherPanelBrush" Color="#B3300817"/>
                    <SolidColorBrush x:Key="LauncherBorderBrush" Color="#906F3045"/>
                    <SolidColorBrush x:Key="LauncherMutedBrush" Color="#C7AEB7"/>
                    <SolidColorBrush x:Key="LauncherDialogBrush" Color="#FA23050F"/>
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#99420D20"/>
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#B3641831"/>
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#80300817"/>
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#906F3045"/>
                    <SolidColorBrush x:Key="TextControlBackground" Color="#B3300817"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#CC420D20"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF300817"/>
                    <SolidColorBrush x:Key="ContentDialogBackground" Color="#FF300817"/>
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF300817"/>
                    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF4D0B20"/>
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FF300817"/>
                    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FF3B0818"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF300817"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FF300817"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#CC64182F"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#DD76223A"/>
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#4D0B20"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#64182F"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#3B0818"/>
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="White"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White"/>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4D0B20"/>
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#64182F"/>
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#3B0818"/>
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#DC819B"/>
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#C56582"/>
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#AE536E"/>
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="White"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="LauncherSurfaceTint" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="LauncherAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="LauncherActionBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="LauncherActionHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="LauncherActionPressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="LauncherLibrarySidebarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="LauncherLibraryOverlayBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="LauncherPanelBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="LauncherBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="LauncherMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="LauncherDialogBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
