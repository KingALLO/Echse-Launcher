<Application
    x:Class="Echse.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="LauncherCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="ListViewItemCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="GridViewItemCornerRadius">10</CornerRadius>
            <Style x:Key="ArtworkGridItemStyle" TargetType="GridViewItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="IsTabStop" Value="False"/>
            </Style>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LauncherSurfaceTint" Color="#3809090B"/>
                    <SolidColorBrush x:Key="LauncherTextBrush" Color="#F4F4F5"/>
                    <SolidColorBrush x:Key="LauncherOnActionBrush" Color="White"/>
                    <LinearGradientBrush x:Key="LauncherGradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3809090B" Offset="0"/>
                        <GradientStop Color="#61101114" Offset="1"/>
                    </LinearGradientBrush>
                    <Color x:Key="SystemAccentColor">#D51F30</Color>
                    <Color x:Key="SystemAccentColorLight1">#DA3A49</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF4B55</Color>
                    <Color x:Key="SystemAccentColorLight3">#C8C9CF</Color>
                    <SolidColorBrush x:Key="LauncherAccentBrush" Color="#FF4B55"/>
                    <SolidColorBrush x:Key="LauncherActionBrush" Color="#EBD51F30"/>
                    <SolidColorBrush x:Key="LauncherActionHoverBrush" Color="#EBDA3A49"/>
                    <SolidColorBrush x:Key="LauncherActionPressedBrush" Color="#EBAA1926"/>
                    <SolidColorBrush x:Key="LauncherLibrarySidebarBrush" Color="#61101114"/>
                    <SolidColorBrush x:Key="LauncherLibraryOverlayBrush" Color="#61101114"/>
                    <SolidColorBrush x:Key="LauncherPanelBrush" Color="#57292A2E"/>
                    <SolidColorBrush x:Key="LauncherBorderBrush" Color="#8C56575E"/>
                    <SolidColorBrush x:Key="LauncherMutedBrush" Color="#C8C9CF"/>
                    <SolidColorBrush x:Key="LauncherDialogBrush" Color="#F0202125"/>
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#4C292A2E"/>
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#4C292A2E"/>
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4C292A2E"/>
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#8C56575E"/>
                    <SolidColorBrush x:Key="TextControlBackground" Color="#4C292A2E"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#6B292A2E"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#80292A2E"/>
                    <SolidColorBrush x:Key="ContentDialogBackground" Color="#F0202125"/>
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F0202125"/>
                    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#F0202125"/>
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#F0202125"/>
                    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#F0202125"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F0202125"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F0202125"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#57292A2E"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#75292A2E"/>
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#EBD51F30"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#EBDA3A49"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#EBAA1926"/>
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="White"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White"/>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#EBD51F30"/>
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#EBDA3A49"/>
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#EBAA1926"/>
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF4B55"/>
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF4B55"/>
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF4B55"/>
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="White"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="LauncherTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="LauncherOnActionBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                    <LinearGradientBrush x:Key="LauncherGradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{ThemeResource SystemColorWindowColor}" Offset="0"/>
                        <GradientStop Color="{ThemeResource SystemColorWindowColor}" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="LauncherSurfaceTint" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="LauncherAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="LauncherActionBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="LauncherActionHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="LauncherActionPressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="LauncherLibrarySidebarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="LauncherLibraryOverlayBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="LauncherPanelBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="LauncherBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="LauncherMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="LauncherDialogBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
